#USING LOOPS


#Define variable i and enter condition when it does not equal 0 print Meow
#Indent line to execute only as part of the loop as long as i does not equal 0 
i = 3 
while i != 0:
    print("Meow")
    i = i - 1
#Now we said with each iteration of the loop we subtract 1 from I - the loop will stop once the variable equals 0 

#Same logic as above but the block of code executes as long as i is less than 3 - once the condition is not met the block of code does not execute
i = 0
while i < 3:
    print ("Woof")
    i = i + 1 

#i will take on the value of each item in the list - the code block will execute for each item in the list

for i in [0, 1, 2]:
    print("Meow") 
#Here we created a list of 3 items

#We can also use the function range() to create a list of numbers - it creates a sequence of numbers starting from 0 and ending at the number specified (not included that number) - e.g. range(3) creates a list of 0, 1, 2
#The For loop now executes the block of code based on the number of items in the list we created with the function range(3) 
for i in range(3):
    print("Woof")

#If we need to use a variable but do not care about it / or need it later we label it _ (this is a common convention) 

#Alternatively we can use multiplication operater to print something multiple times (this is without using a loop)
#But we need to clean it up otherwise it prints woofwoofwoof 
#We use /n to create a new line after each print statement and end="" to remove the extra line at the end of the print statements 
print ("Woof\n" * 3, end="")  